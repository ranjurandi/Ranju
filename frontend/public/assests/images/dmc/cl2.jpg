    <!-- Prevent theme flash: Apply stored theme immediately before page renders -->
    <script>
      (function () {
        try {
          var theme = localStorage.getItem("emergent-theme");
          if (!theme) {
            var isLoggedIn = Object.keys(localStorage).some(function (k) {
              return k.startsWith("sb-") && k.endsWith("-auth-token");
            });
            theme = isLoggedIn ? "dark" : "system";
          }
          if (theme === "light" || (theme === "system" && window.matchMedia("(prefers-color-scheme: light)").matches)) {
            document.documentElement.classList.remove("dark");
            document.documentElement.classList.add("light");
          }
        } catch (e) {}
      })();
    </script>
    <!-- Tracking allowlist — gates GTM/VWO/Rewardful/PartnerStack/Meta/TikTok Pixel to prod hosts only.
         (For PartnerStack — an essential-category script — this host gate is the ONLY gate.)
         Prevents third-party tracking scripts from firing on preview/CDN hosts (e.g. *.preview.emergentagent.com)
         where our bundle is served as a wake-up page, which would attribute pixel events to user-preview domains. -->
    <script>
      (function () {
        var ALLOWED_TRACKING_HOSTS = ["app.emergent.sh", "dev.emergentagent.com"];
        // On /wing/widget/<hmac> the path segment is the credential, and every tracker below sends the page URL.
        // Tested decoded, as React Router matches it (/%77ing/widget/… is the same page); a malformed path stays dark.
        var credentialPath = true;
        try {
          credentialPath = /^\/wing\/widget(\/|$)/i.test(decodeURIComponent(window.location.pathname));
        } catch (e) {}
        window.__emergentTrackingAllowed =
          !credentialPath && ALLOWED_TRACKING_HOSTS.indexOf(window.location.hostname) !== -1;
        var h = window.location.hostname;
        // Exact or subdomain suffix match, not substring: a bare indexOf lets a crafted hostname
        // (e.g. getwingman.sh.attacker.com) satisfy the wingman consent/host gate.
        window.__wingmanTrackingAllowed =
          !credentialPath &&
          (h === "getwingman.sh" ||
            h.endsWith(".getwingman.sh") ||
            h === "getwingman.com" ||
            h.endsWith(".getwingman.com"));
      })();
    </script>
    <!-- Strips auth credentials from the URL before the third-party scripts below read document.URL at parse time.
         Only on hosts where those scripts may load (the allowlist above, before the consent gate narrows it): on
         preview/CDN hosts this bundle is a wake-up page, and the URL's credentials belong to the user's app. -->
    <script>
      (function () {
        if (!window.__emergentTrackingAllowed && !window.__wingmanTrackingAllowed) return;
        var hash = window.location.hash;
        // Decoded, as React Router matches routes (/%63onfirm-email is the /confirm-email page); raw if malformed, as there.
        var path = window.location.pathname;
        try {
          path = decodeURIComponent(path);
        } catch (e) {}
        // Fails closed: if the URL can't be parsed, any key=value fragment goes; a plain #anchor stays.
        var dropFragment = hash.indexOf("=") !== -1;
        var cleanSearch = null;
        try {
          // Names are compared decoded, as /auth/callback reads them, so #%61ccess_token= can't slip past.
          var fragment = new URLSearchParams(hash.slice(1));
          var fragmentCredentials = [
            "access_token",
            "refresh_token",
            "provider_token",
            "provider_refresh_token",
            "id_token",
            "jwt",
            "sig",
            "signature",
            "error",
            "error_code",
            "error_description",
          ];
          dropFragment = false;
          for (var f = 0; f < fragmentCredentials.length; f++) {
            if (fragment.has(fragmentCredentials[f])) dropFragment = true;
          }
          // The query string carries credentials too. Nothing reads these names from it, so they are dropped; the
          // one-time /confirm-email `token`, which the server exchanges for a session, is handed to the page instead.
          var query = new URLSearchParams(window.location.search);
          var queryCredentials = [
            "access_token",
            "refresh_token",
            "provider_token",
            "provider_refresh_token",
            "id_token",
            "jwt",
            "sig",
            "signature",
            "token_hash",
          ];
          if (/^\/confirm-email\/?$/i.test(path) && query.get("token")) {
            window.__emergentAuthQuery = { token: query.get("token") };
            queryCredentials.push("token");
          }
          var found = false;
          for (var i = 0; i < queryCredentials.length; i++) {
            if (!query.has(queryCredentials[i])) continue;
            query.delete(queryCredentials[i]);
            found = true;
          }
          if (found) cleanSearch = query.toString();
        } catch (e) {
          // Reported from main.tsx once monitoring is up. The query is kept: dropping it would also drop ?code=.
          window.__emergentAuthUrlParseFailed = true;
        }
        if (dropFragment && /^\/auth\/callback\/?$/i.test(path)) {
          window.__emergentAuthFragment = { params: hash.slice(1) };
        }
        if (!dropFragment && cleanSearch === null) return;
        // Not pathname + search: a path that starts with // would resolve to another origin.
        var clean = window.location.href.split("#")[0];
        if (cleanSearch !== null) clean = clean.split("?")[0] + (cleanSearch ? "?" + cleanSearch : "");
        if (!dropFragment) clean += hash;
        try {
          window.history.replaceState(window.history.state, "", clean);
        } catch (e) {
          try {
            window.sessionStorage.setItem("emergent_auth_fragment_reload", "1");
          } catch (_) {}
          window.stop();
          window.location.replace(clean);
        }
      })();
    </script>
    <!-- GDPR consent gate — synchronous, must run right after the host allowlist above and BEFORE
         every GTM/gtag/pixel block below. Reads the edge verdict cookie (emergent_geo_consent:
         "1" = consent required, "0" = not required; missing = FAIL-OPEN, i.e. NOT required) and the
         user's choice cookie (emergent_consent, which carries per-category grants in `cats`).
         PER-CATEGORY gate: each NON-Google script gates on host allowed AND its category's grant —
           __emergentAdvertisingAllowed (Meta/TikTok/Rewardful),
           __emergentAnalyticsAllowed (VWO). These stay fully blocked until consent.
         PartnerStack is the exception: disclosed as ESSENTIAL (partner referral attribution), so it
         boots on __emergentHostAllowed alone and no category grant gates it.
         GOOGLE tags (Consent Mode v2 BASIC / opt-in) also load only AFTER consent — withheld entirely
         until the relevant category is granted: GTM gates on __emergentGoogleTagsAllowed (host AND
         advertising consent) and the Wingman GA4 gtag on __wingmanGoogleTagsAllowed (host AND analytics
         consent). Consent Mode signals (default-denied -> per-category granted) below still govern
         storage once a tag loads. __emergentTrackingAllowed is kept as the coarse host AND (advertising
         OR analytics) signal for the gtmService dataLayer funnel.
         PRECEDENCE: an explicit stored choice OUTRANKS the verdict and is honoured in every region.
         Only a visitor with NO stored choice falls back to the verdict, so verdict "0" + no choice
         (the 99% rest-of-world case, who never saw a banner) leaves every flag byte-for-byte at
         today's values and pushes no Consent Mode calls (rest-of-world invariant preserved).
         Mirrors isCategoryAllowed/getConsentCategories in src/lib/consent/consent.ts — keep the
         readers in sync. -->
    <script>
      (function () {
        function escapeForRegExp(s) {
          return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        }
        function readCookie(name) {
          try {
            var match = document.cookie.match(new RegExp("(^|;\\s*)" + escapeForRegExp(name) + "=([^;]*)"));
            return match ? match[2] : null;
          } catch (e) {
            // document.cookie can throw (sandboxed iframe / fully blocked storage). Return null so the
            // gate proceeds on the fail-open default (verdict null -> not required -> trackers allowed),
            // matching consent.ts. A stored choice is not lost with it: the localStorage mirror read
            // below still recovers an earlier accept/reject whenever storage itself is readable.
            console.warn("[consent-gate]", e);
            return null;
          }
        }
        var verdict = readCookie("emergent_geo_consent");
        // Dev-only override, gated to localhost so it can never bypass the consent gate on a production
        // host, and honoured only when the edge cookie is absent/unreadable. (Inline scripts do not get
        // import.meta.env.DEV substitution, so this mirrors consent.ts's build gate via the hostname.)
        var isDevHost = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
        if (isDevHost && verdict !== "0" && verdict !== "1") {
          try {
            var devVerdict = localStorage.getItem("emergent_consent_dev_verdict");
            if (devVerdict === "0" || devVerdict === "1") verdict = devVerdict;
          } catch (e) {
            console.warn("[consent-gate]", e);
          }
        }
        // Fail-open: only an explicit "1" means consent is required. The edge stamps "0" or "1" on
        // every response it serves, so a missing/garbled verdict means no edge verdict was applied —
        // and with no verdict we neither prompt nor gate. Mirrors consent.ts's isConsentRequired;
        // consentBootstrap.test.ts fails if the two drift.
        var consentRequired = verdict === "1";

        // Tolerant reader for the choice cookie/mirror: captures both the binary choice (c) and the
        // per-category grants (cats). Mirrors getConsentRecord/getConsentCategories in src/lib/consent.
        var choice = null;
        var cats = null;
        function ingestConsent(value) {
          if (!value) return false;
          var decoded = value;
          try {
            decoded = decodeURIComponent(value);
          } catch (e) {
            console.warn("[consent-gate]", e);
          }
          if (decoded === "accepted" || decoded === "rejected") {
            choice = decoded;
            return true;
          }
          try {
            var parsed = JSON.parse(decoded);
            if (parsed && (parsed.c === "accepted" || parsed.c === "rejected")) {
              choice = parsed.c;
              if (parsed.cats && typeof parsed.cats === "object") cats = parsed.cats;
              return true;
            }
          } catch (e) {
            console.warn("[consent-gate]", e);
          }
          return false;
        }
        try {
          if (!ingestConsent(readCookie("emergent_consent"))) {
            // localStorage mirror fallback (tolerant reader, same as src/lib/consent).
            try {
              ingestConsent(localStorage.getItem("emergent_consent"));
            } catch (e) {
              console.warn("[consent-gate]", e);
            }
          }
        } catch (e) {
          console.warn("[consent-gate]", e);
        }

        // Per-category enforcement (mirrors isCategoryAllowed): an explicit stored choice OUTRANKS the
        // geo verdict, so a visitor who saved preferences keeps them in EVERY region (travel / VPN off /
        // an edge verdict flip to "0" can no longer silently re-enable trackers). `cats` governs when
        // present; a legacy record without `cats` falls back to its binary choice (accepted -> all on).
        // Only with NO stored choice at all do we fall back to the verdict: rest-of-world (verdict 0)
        // allows every category, consent-required fails closed.
        function categoryAllowed(key) {
          if (cats) return cats[key] === true;
          if (choice) return choice === "accepted";
          return !consentRequired;
        }
        var advertisingAllowed = categoryAllowed("advertising");
        var analyticsAllowed = categoryAllowed("analytics");

        window.__emergentConsentRequired = consentRequired;
        window.__emergentConsentChoice = choice;
        var hostAllowed = window.__emergentTrackingAllowed;
        var wingmanHostAllowed = window.__wingmanTrackingAllowed;
        // Google tags load only AFTER consent (opt-in) — never anonymously before it. The gate keeps the
        // existing host allowlist and folds the relevant category grant on top (host gating preserved,
        // never replaced). The GTM container is advertising (Meta/TikTok/Google Ads) -> gate on
        // advertising; the Wingman GA4 tag -> gate on analytics. categoryAllowed() already folds in the
        // verdict fallback, so verdict "0" (ROW) with NO stored choice still grants both exactly as
        // before — but a ROW visitor who stored a choice now has it honoured here too. The raw host
        // allowlist is exposed so the in-session accept flow can boot the tag the moment consent is
        // granted (see consentService.reconcileConsentCategories).
        window.__emergentHostAllowed = hostAllowed;
        window.__wingmanHostAllowed = wingmanHostAllowed;
        window.__emergentGoogleTagsAllowed = hostAllowed && advertisingAllowed;
        window.__wingmanGoogleTagsAllowed = wingmanHostAllowed && analyticsAllowed;
        // Per-category script gates: host allowlist AND that category's grant. The NON-Google trackers
        // (Meta/TikTok/Rewardful on advertising; VWO on analytics) have no Consent Mode and stay fully
        // blocked until consent — these gates are unchanged by Advanced mode. PartnerStack is NOT among
        // them: it is essential-category and gates on __emergentHostAllowed only.
        window.__emergentAdvertisingAllowed = hostAllowed && advertisingAllowed;
        window.__emergentAnalyticsAllowed = hostAllowed && analyticsAllowed;
        // Coarse consent+host signal — host AND (advertising OR analytics). Mirrors isTrackingAllowed()
        // in src/lib/consent; retained for category-agnostic callers and the gtmService dataLayer
        // funnel. It NO LONGER gates the GTM loader (that is __emergentGoogleTagsAllowed above).
        window.__emergentTrackingAllowed = hostAllowed && (advertisingAllowed || analyticsAllowed);
        // Coarse wingman consent+host signal — wingman host AND analytics. Retained for category-
        // agnostic callers; the Wingman GA4 loader now gates on __wingmanGoogleTagsAllowed above.
        window.__wingmanTrackingAllowed = wingmanHostAllowed && analyticsAllowed;

        // Google Consent Mode for visitors with a STORED CHOICE. The Google tags now load ONLY after a
        // category is granted (gate flags above), so there is no pre-consent "anonymous" load to hold:
        // the old default-denied signal plus ads_data_redaction/url_passthrough are gone. When a grant
        // exists we set the granted per-category state up front so a RETURNING user's tags (which load at
        // parse) honor partial grants; a fresh in-session grant is handled by consentService. Keyed on
        // "has a stored choice" rather than the verdict: a ROW visitor with a PARTIAL stored grant must
        // get the matching denials too, or the tags their grant does load would treat the denied
        // categories as granted-by-default. Scoped to allowlisted hosts so non-allowlisted hosts keep
        // window.dataLayer undefined exactly as today; a ROW visitor with NO stored choice still has no
        // cats/choice, so this sets nothing and keeps full, un-gated behavior byte-for-byte.
        if ((cats || choice) && (advertisingAllowed || analyticsAllowed) && (hostAllowed || wingmanHostAllowed)) {
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          gtag("consent", "default", {
            ad_storage: advertisingAllowed ? "granted" : "denied",
            ad_user_data: advertisingAllowed ? "granted" : "denied",
            ad_personalization: advertisingAllowed ? "granted" : "denied",
            analytics_storage: analyticsAllowed ? "granted" : "denied",
          });
        }
      })();
    </script>
    
