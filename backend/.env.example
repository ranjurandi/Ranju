# Use mongodb:// for a local server or mongodb+srv:// for an Atlas cluster.
# For Atlas, include the real cluster hostname and URL-encode special characters
# in credentials. Do not duplicate the MongoDB URI scheme.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=godavari_waves
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
ADMIN_USERNAME=change-this-before-use
# ADMIN_PASSWORD may be a plaintext secret or a bcrypt hash beginning with $2.
ADMIN_PASSWORD=change-this-before-use
ADMIN_DISPLAY_NAME=Godavari Wave Administrator
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CAREER_RESUME_DIR=./private_uploads/career_resumes
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
